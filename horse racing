<script>
    const horses = [
        {
            id: 0,
            name: "Thunder",
            color: "#ef4444",
            odds: 2.5,
            stamina: 0.95,
            speed: 3.2,
            sprintBurst: 1.4,
            jockey: "Mike Smith",
            description: "Powerful front-runner with fierce consistency."
        },
        {
            id: 1,
            name: "Lightning",
            color: "#f59e0b",
            odds: 3.8,
            stamina: 0.88,
            speed: 3.4,
            sprintBurst: 1.8,
            jockey: "Joel Rosario",
            description: "Explosive sprinter who loves the home stretch."
        },
        {
            id: 2,
            name: "Storm",
            color: "#0284c7",
            odds: 5.0,
            stamina: 0.98,
            speed: 3.0,
            sprintBurst: 1.6,
            jockey: "Flavien Prat",
            description: "Endurance master capable of dramatic upsets."
        },
        {
            id: 3,
            name: "Blaze",
            color: "#10b981",
            odds: 2.0,
            stamina: 0.92,
            speed: 3.3,
            sprintBurst: 1.5,
            jockey: "Irad Ortiz Jr.",
            description: "Heavy derby favorite with blazing acceleration."
        }
    ];

    let bankroll = parseInt(localStorage.getItem("derby_bankroll")) || 1000;
    let selectedHorseId = 0;
    let currentBet = 25;
    let raceRunning = false;
    let raceInterval = null;
    let raceStartTime = 0;
    let raceSpeedMultiplier = 1.0;
    let boostsRemaining = 3;
    let soundEnabled = true;

    let positions = [15, 15, 15, 15];
    let baseVelocities = [0, 0, 0, 0];
    let finishOrder = [];
    let finishTimes = {};
    let activeLeader = -1;

    let audioCtx = null;

    function getAudioContext() {
        if (!audioCtx) {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            audioCtx = new AudioContextClass();
        }
        if (audioCtx.state === 'suspended') {
            audioCtx.resume();
        }
        return audioCtx;
    }

    function toggleSound() {
        soundEnabled = !soundEnabled;
        document.getElementById("soundState").textContent = soundEnabled ? "Sound: ON" : "Sound: OFF";
        document.getElementById("soundIcon").textContent = soundEnabled ? "🔊" : "🔇";
    }

    function playCallToPost() {
        if (!soundEnabled) return;
        try {
            const ctx = getAudioContext();
            const now = ctx.currentTime;
            const notes = [
                { f: 523.25, d: 0.15 }, { f: 392.00, d: 0.15 }, { f: 523.25, d: 0.15 }, { f: 659.25, d: 0.15 },
                { f: 783.99, d: 0.35 }, { f: 659.25, d: 0.15 }, { f: 783.99, d: 0.15 }, { f: 659.25, d: 0.15 },
                { f: 523.25, d: 0.15 }, { f: 392.00, d: 0.15 }, { f: 523.25, d: 0.40 }
            ];

            let time = now;
            notes.forEach(note => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(note.f, time);

                const filter = ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(1600, time);

                gain.gain.setValueAtTime(0, time);
                gain.gain.linearRampToValueAtTime(0.2, time + 0.03);
                gain.gain.exponentialRampToValueAtTime(0.001, time + note.d);

                osc.connect(filter);
                filter.connect(gain);
                gain.connect(ctx.destination);

                osc.start(time);
                osc.stop(time + note.d);
                time += note.d + 0.04;
            });
        } catch (e) {}
    }

    function playGateBell() {
        if (!soundEnabled) return;
        try {
            const ctx = getAudioContext();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'square';
            osc.frequency.setValueAtTime(880, ctx.currentTime);
            gain.gain.setValueAtTime(0.25, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.3);
        } catch(e){}
    }

    let nextGallopTime = 0;
    function playHoofbeats() {
        if (!soundEnabled || !raceRunning) return;
        const now = Date.now();
        if (now < nextGallopTime) return;

        nextGallopTime = now + (110 / raceSpeedMultiplier);

        try {
            const ctx = getAudioContext();
            const bufferSize = ctx.sampleRate * 0.04;
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }

            const noise = ctx.createBufferSource();
            noise.buffer = buffer;

            const filter = ctx.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.value = 180 + Math.random() * 60;
            filter.Q.value = 3.0;

            const gain = ctx.createGain();
            gain.gain.setValueAtTime(0.12, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.04);

            noise.connect(filter);
            filter.connect(gain);
            gain.connect(ctx.destination);

            noise.start();
        } catch(e){}
    }

    function playWinJingle() {
        if (!soundEnabled) return;
        try {
            const ctx = getAudioContext();
            const notes = [523.25, 659.25, 783.99, 1046.50];
            notes.forEach((freq, idx) => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.12);
                gain.gain.setValueAtTime(0.2, ctx.currentTime + idx * 0.12);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.12 + 0.35);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(ctx.currentTime + idx * 0.12);
                osc.stop(ctx.currentTime + idx * 0.12 + 0.35);
            });
        } catch(e){}
    }

    function playWhipSound() {
        if (!soundEnabled) return;
        try {
            const ctx = getAudioContext();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(900, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(150, ctx.currentTime + 0.15);
            gain.gain.setValueAtTime(0.3, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.15);
        } catch(e){}
    }

    function initApp() {
        renderWallet();
        renderBetGrid();
        renderGateStalls();
        updatePotentialPayout();
    }

    function renderWallet() {
        document.getElementById("walletDisplay").textContent = "$" + bankroll.toLocaleString();
        localStorage.setItem("derby_bankroll", bankroll);
    }

    function resetBankroll() {
        bankroll = 1000;
        renderWallet();
        updateAnnouncer("Purse refilled to $1,000! Good luck at the track!");
    }

    function renderGateStalls() {
        const gateArea = document.getElementById("gateArea");
        gateArea.innerHTML = "";
        for (let i = 0; i < horses.length; i++) {
            const stall = document.createElement("div");
            stall.className = "gate-stall";
            stall.textContent = "GATE " + (i + 1);
            gateArea.appendChild(stall);
        }
    }

    function renderBetGrid() {
        const grid = document.getElementById("horseBetGrid");
        grid.innerHTML = "";

        horses.forEach(horse => {
            const card = document.createElement("div");
            card.className = "horse-bet-card" + (horse.id === selectedHorseId ? " selected" : "");
            card.id = "betCard" + horse.id;
            card.onclick = () => selectHorse(horse.id);

            card.innerHTML = `
                <div class="bet-horse-meta">
                    <div class="bet-horse-color" style="background: ${horse.color};"></div>
                    <div>
                        <div class="bet-horse-name">#${horse.id + 1} ${horse.name}</div>
                        <div style="font-size: 10px; color: var(--text-muted);">${horse.jockey}</div>
                    </div>
                </div>
                <div class="bet-horse-odds">${horse.odds.toFixed(1)}x</div>
            `;

            grid.appendChild(card);
        });
    }

    function selectHorse(id) {
        if (raceRunning) return;
        selectedHorseId = id;
        document.querySelectorAll(".horse-bet-card").forEach(c => c.classList.remove("selected"));
        const activeCard = document.getElementById("betCard" + id);
        if (activeCard) activeCard.classList.add("selected");

        const horse = horses[id];
        document.getElementById("selectedHorseText").textContent = `#${horse.id + 1} ${horse.name}`;
        updatePotentialPayout();
        updateAnnouncer(`You selected #${horse.id + 1} ${horse.name} (${horse.odds}x odds). ${horse.description}`);
    }

    function selectHorseAndPlay(id) {
        selectHorse(id);
        scrollAndFocusArena();
    }

    function scrollAndFocusArena() {
        const arena = document.getElementById("arena");
        arena.scrollIntoView({ behavior: 'smooth' });
    }

    function setBetAmount(amount, buttonEl) {
        if (raceRunning) return;
        if (amount === 'all') {
            currentBet = bankroll > 0 ? bankroll : 25;
        } else {
            currentBet = amount;
        }

        document.querySelectorAll(".chip-btn").forEach(b => b.classList.remove("active"));
        if (buttonEl) buttonEl.classList.add("active");
        updatePotentialPayout();
    }

    function updatePotentialPayout() {
        const horse = horses[selectedHorseId];
        const effectiveBet = Math.min(currentBet, bankroll);
        const payout = (effectiveBet * horse.odds).toFixed(2);
        document.getElementById("potentialPayoutText").textContent = "$" + parseFloat(payout).toLocaleString();
    }

    function updateAnnouncer(message, isHighlight = false) {
        const feed = document.getElementById("announcerFeed");
        feed.textContent = message;
        if (isHighlight) {
            feed.classList.add("highlight");
        } else {
            feed.classList.remove("highlight");
        }
    }

    function startRace() {
        if (raceRunning) return;

        if (bankroll <= 0) {
            alert("Your purse is empty! Click 'Refill Bankroll' to claim $1,000 in chips.");
            return;
        }

        const wager = Math.min(currentBet, bankroll);
        bankroll -= wager;
        renderWallet();

        raceRunning = true;
        finishOrder = [];
        finishTimes = {};
        positions = [15, 15, 15, 15];
        activeLeader = -1;
        boostsRemaining = 3;

        document.getElementById("boostCount").textContent = boostsRemaining;
        document.getElementById("startBtn").disabled = true;
        document.getElementById("boostBtn").disabled = false;
        document.getElementById("resetBtn").disabled = true;

        document.querySelectorAll(".horse-container").forEach(h => h.classList.add("galloping"));

        playCallToPost();
        setTimeout(playGateBell, 800);

        updateAnnouncer("🎺 The horses are locked in the gates... AND THEY'RE OFF!", true);

        baseVelocities = horses.map(h => {
            const staminaFactor = 0.9 + Math.random() * 0.2;
            return (h.speed * staminaFactor) * (0.9 + Math.random() * 0.3);
        });

        raceStartTime = Date.now();
        raceInterval = setInterval(updateRace, 40);
    }

    function triggerJockeyBoost() {
        if (!raceRunning || boostsRemaining <= 0) return;

        boostsRemaining--;
        document.getElementById("boostCount").textContent = boostsRemaining;
        if (boostsRemaining === 0) {
            document.getElementById("boostBtn").disabled = true;
        }

        playWhipSound();

        positions[selectedHorseId] += 25 * raceSpeedMultiplier;
        baseVelocities[selectedHorseId] += 0.8;

        const horseName = horses[selectedHorseId].name;
        updateAnnouncer(`⚡ WHIP SURGE! ${horseName}'s jockey urges the champion forward!`, true);
    }

    window.addEventListener("keydown", (e) => {
        if (e.code === "Space" && raceRunning) {
            e.preventDefault();
            triggerJockeyBoost();
        }
    });

    function updateRace() {
        const track = document.getElementById("raceTrack");
        const trackWidth = track.clientWidth;
        const finishDistance = trackWidth - 145;

        const elapsedSec = ((Date.now() - raceStartTime) / 1000) * raceSpeedMultiplier;
        document.getElementById("raceTimeDisplay").textContent = elapsedSec.toFixed(2) + "s";

        playHoofbeats();

        let currentBestPos = -1;
        let currentLeaderId = -1;

        for (let i = 0; i < horses.length; i++) {
            if (finishOrder.includes(i)) continue;

            let sprintBonus = 0;
            if (positions[i] > finishDistance * 0.65) {
                sprintBonus = (Math.random() * horses[i].sprintBurst * 0.4);
            }

            const flutter = (Math.random() - 0.48) * 1.8;
            positions[i] += (baseVelocities[i] + sprintBonus + flutter) * raceSpeedMultiplier;

            const horseContainer = document.getElementById("horseContainer" + i);
            const clampedPos = Math.min(positions[i], finishDistance);
            horseContainer.style.left = clampedPos + "px";

            if (positions[i] > currentBestPos) {
                currentBestPos = positions[i];
                currentLeaderId = i;
            }

            if (positions[i] >= finishDistance) {
                finishOrder.push(i);
                finishTimes[i] = elapsedSec.toFixed(2);
                horseContainer.style.left = finishDistance + "px";
                document.getElementById("horseContainer" + i).classList.remove("galloping");

                if (finishOrder.length === 1) {
                    updateAnnouncer(`🏁 PHOTO AT THE WIRE! #${horses[i].id + 1} ${horses[i].name} CROSSES FIRST!`, true);
                }
            }
        }

        if (currentLeaderId !== -1 && currentLeaderId !== activeLeader) {
            activeLeader = currentLeaderId;
            document.querySelectorAll(".leader-crown").forEach(c => c.style.display = "none");
            const crown = document.getElementById("crown" + activeLeader);
            if (crown) crown.style.display = "block";

            if (finishOrder.length === 0) {
                const leadHorse = horses[activeLeader];
                updateAnnouncer(`🔥 #${leadHorse.id + 1} ${leadHorse.name} bursts ahead to take the lead!`);
            }
        }

        if (finishOrder.length === horses.length) {
            endRace();
        }
    }

    function endRace() {
        clearInterval(raceInterval);
        raceRunning = false;

        document.getElementById("startBtn").disabled = false;
        document.getElementById("boostBtn").disabled = true;
        document.getElementById("resetBtn").disabled = false;
        document.querySelectorAll(".horse-container").forEach(h => h.classList.remove("galloping"));

        const winnerId = finishOrder[0];
        const winner = horses[winnerId];
        const userWon = (winnerId === selectedHorseId);
        const wager = Math.min(currentBet, bankroll + currentBet);

        if (userWon) {
            const winnings = Math.round(wager * winner.odds);
            bankroll += winnings;
            renderWallet();
            playWinJingle();
            triggerConfetti();
            updateAnnouncer(`🎉 VICTORY! Your horse #${winner.id + 1} ${winner.name} WINS! You collected $${winnings.toLocaleString()}!`, true);
        } else {
            renderWallet();
            updateAnnouncer(`🏁 #${winner.id + 1} ${winner.name} wins the derby. Better luck on the next post!`);
        }

        renderLeaderboardResults();
    }

    function renderLeaderboardResults() {
        const tbody = document.getElementById("resultsTableBody");
        tbody.innerHTML = "";

        const medals = ["🥇 1st", "🥈 2nd", "🥉 3rd", "🏅 4th"];

        finishOrder.forEach((horseIndex, rank) => {
            const horse = horses[horseIndex];
            const isWinner = rank === 0;
            const isSelected = horseIndex === selectedHorseId;
            const row = document.createElement("tr");
            if (isWinner) row.className = "winner-row";

            row.innerHTML = `
                <td><span class="medal">${medals[rank]}</span></td>
                <td>
                    <strong style="color: ${horse.color};">#${horse.id + 1} ${horse.name}</strong>
                    ${isSelected ? ' <span style="font-size: 10px; background: rgba(245,158,11,0.2); color: #f59e0b; padding: 2px 6px; border-radius: 4px;">YOUR BET</span>' : ''}
                </td>
                <td>${horse.jockey}</td>
                <td><strong>${finishTimes[horseIndex]}s</strong></td>
                <td>${horse.odds.toFixed(1)}x</td>
            `;

            tbody.appendChild(row);
        });
    }

    function resetRace() {
        clearInterval(raceInterval);
        raceRunning = false;
        positions = [15, 15, 15, 15];
        finishOrder = [];
        activeLeader = -1;
        boostsRemaining = 3;

        document.getElementById("boostCount").textContent = boostsRemaining;
        document.getElementById("startBtn").disabled = false;
        document.getElementById("boostBtn").disabled = true;
        document.getElementById("resetBtn").disabled = false;
        document.getElementById("raceTimeDisplay").textContent = "00.00s";

        document.querySelectorAll(".leader-crown").forEach(c => c.style.display = "none");
        document.querySelectorAll(".horse-container").forEach((container) => {
            container.classList.remove("galloping");
            container.style.left = "15px";
        });

        updateAnnouncer("Gating reset complete. Place your wagers and get ready for the next race!");
    }

    function setWeather(weather, btn) {
        document.querySelectorAll(".theme-select-btn").forEach(b => {
            if (b.parentElement === btn.parentElement) b.classList.remove("active");
        });
        btn.classList.add("active");

        const overlay = document.getElementById("weatherOverlay");
        overlay.className = "track-weather-overlay";
        const label = document.getElementById("trackConditionLabel");

        if (weather === 'sunset') {
            overlay.classList.add("weather-sunset");
            label.textContent = "🌅 Track: GOLDEN STAKES";
        } else if (weather === 'night') {
            overlay.classList.add("weather-night");
            label.textContent = "🌙 Track: NIGHT FLOODLIGHTS";
        } else if (weather === 'rain') {
            overlay.classList.add("weather-rain");
            label.textContent = "🌧️ Track: MUDDY TURF";
        } else {
            label.textContent = "☀️ Track: FIRM TURF";
        }
    }

    function setRaceSpeed(multiplier, btn) {
        document.querySelectorAll(".theme-select-btn").forEach(b => {
            if (b.parentElement === btn.parentElement) b.classList.remove("active");
        });
        btn.classList.add("active");
        raceSpeedMultiplier = multiplier;
    }

    function triggerConfetti() {
        const canvas = document.getElementById("confettiCanvas");
        const ctx = canvas.getContext("2d");
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        const particles = [];
        const colors = ["#f59e0b", "#10b981", "#ef4444", "#3b82f6", "#ec4899", "#fbbf24"];

        for (let i = 0; i < 120; i++) {
            particles.push({
                x: canvas.width / 2,
                y: canvas.height / 2,
                vx: (Math.random() - 0.5) * 18,
                vy: (Math.random() - 0.8) * 16,
                size: Math.random() * 8 + 4,
                color: colors[Math.floor(Math.random() * colors.length)],
                rotation: Math.random() * 360,
                rSpeed: (Math.random() - 0.5) * 10,
                gravity: 0.35,
                opacity: 1
            });
        }

        let animationFrame;
        function renderConfetti() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            let alive = false;

            particles.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;
                p.vy += p.gravity;
                p.rotation += p.rSpeed;
                p.opacity -= 0.008;

                if (p.opacity > 0) {
                    alive = true;
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate((p.rotation * Math.PI) / 180);
                    ctx.fillStyle = p.color;
                    ctx.globalAlpha = Math.max(0, p.opacity);
                    ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
                    ctx.restore();
                }
            });

            if (alive) {
                animationFrame = requestAnimationFrame(renderConfetti);
            } else {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                cancelAnimationFrame(animationFrame);
            }
        }
        renderConfetti();
    }

    window.addEventListener("resize", () => {
        const canvas = document.getElementById("confettiCanvas");
        if (canvas) {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
    });

    window.addEventListener("DOMContentLoaded", initApp);
</script>

