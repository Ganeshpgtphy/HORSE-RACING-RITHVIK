<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🏇 Royal Derby: Grand Championship Horse Racing 2026</title>
<meta name="description" content="Experience the pulse-pounding excitement of the Royal Derby Championship 2026. Live interactive horse racing, real-time odds, tactical jockey boosts, and grand purse wagering.">

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-main: #060b14;
        --bg-surface: #0c1524;
        --bg-surface-elevated: rgba(18, 30, 50, 0.75);
        --border-glass: rgba(255, 255, 255, 0.12);
        --border-glass-gold: rgba(245, 158, 11, 0.35);
        
        --gold-primary: #f59e0b;
        --gold-light: #fcd34d;
        --gold-dark: #b45309;
        --gold-glow: rgba(245, 158, 11, 0.35);
        
        --emerald-primary: #10b981;
        --emerald-glow: rgba(16, 185, 129, 0.3);
        --turf-green: #1e5631;
        --turf-stripe: #154224;

        --crimson-accent: #ef4444;
        --blue-accent: #0ea5e9;

        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;

        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 22px;
        --radius-full: 9999px;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
        color: var(--text-primary);
        line-height: 1.6;
        overflow-x: hidden;
    }

    .ambient-glow-1 {
        position: fixed;
        top: -150px;
        left: 20%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.12) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .ambient-glow-2 {
        position: fixed;
        bottom: 10%;
        right: 5%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.08) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .wrapper {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 20px;
        position: relative;
        z-index: 1;
    }

    /* Top Navigation Bar */
    .navbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(6, 11, 20, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-glass);
        padding: 14px 0;
        transition: all 0.3s ease;
    }

    .nav-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .nav-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #fff;
    }

    .nav-logo-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--gold-primary), #d97706);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        box-shadow: 0 4px 18px var(--gold-glow);
    }

    .nav-brand-text h2 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.4rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        background: linear-gradient(90deg, #ffffff, #e2e8f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .nav-brand-text span {
        font-size: 0.72rem;
        color: var(--gold-light);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 700;
        display: block;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 25px;
        list-style: none;
    }

    .nav-link {
        color: var(--text-secondary);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        transition: color 0.2s ease;
    }

    .nav-link:hover {
        color: var(--gold-light);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .purse-pill {
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.35);
        border-radius: var(--radius-full);
        padding: 6px 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
        color: #6ee7b7;
        font-weight: 700;
    }

    .purse-pill span.val {
        font-family: 'Outfit', sans-serif;
        font-size: 1.15rem;
        color: #fff;
    }

    .btn-sound {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--border-glass);
        color: #fff;
        padding: 8px 14px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

    .btn-sound:hover {
        background: rgba(255, 255, 255, 0.12);
    }

    /* Live Racing Ticker */
    .live-ticker-strip {
        background: linear-gradient(90deg, #18263e, #0c182a, #18263e);
        border-bottom: 1px solid rgba(245, 158, 11, 0.25);
        padding: 8px 0;
        overflow: hidden;
        white-space: nowrap;
        position: relative;
    }

    .ticker-track {
        display: inline-flex;
        gap: 50px;
        animation: tickerScroll 32s linear infinite;
    }

    @keyframes tickerScroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .ticker-item {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 0.84rem;
        color: var(--text-secondary);
        font-weight: 600;
    }

    .ticker-tag {
        background: var(--gold-primary);
        color: #000;
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 0.72rem;
        padding: 2px 7px;
        border-radius: 4px;
        letter-spacing: 0.5px;
    }

    .ticker-item strong {
        color: #fff;
    }

    /* Hero Section */
    .hero-section {
        position: relative;
        padding: 70px 0 60px;
        overflow: hidden;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 40px;
        align-items: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid var(--border-glass-gold);
        color: var(--gold-light);
        padding: 6px 16px;
        border-radius: var(--radius-full);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 22px;
        box-shadow: 0 0 20px rgba(245, 158, 11, 0.15);
    }

    .hero-badge-pulse {
        width: 8px;
        height: 8px;
        background: var(--gold-primary);
        border-radius: 50%;
        animation: pulseDot 1.5s infinite;
    }

    @keyframes pulseDot {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.6); opacity: 0.4; }
        100% { transform: scale(1); opacity: 1; }
    }

    .hero-title {
        font-family: 'Outfit', sans-serif;
        font-size: 3.5rem;
        line-height: 1.1;
        font-weight: 900;
        letter-spacing: -1.5px;
        margin-bottom: 20px;
        color: #fff;
    }

    .hero-title .gradient-text {
        background: linear-gradient(135deg, #ffffff 20%, var(--gold-light) 65%, var(--gold-primary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-desc {
        font-size: 1.12rem;
        color: var(--text-secondary);
        margin-bottom: 35px;
        max-width: 580px;
        font-weight: 400;
    }

    .hero-cta-group {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .btn-hero-primary {
        background: linear-gradient(135deg, var(--gold-primary), #d97706);
        color: #000;
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.1rem;
        padding: 16px 34px;
        border-radius: var(--radius-md);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 25px var(--gold-glow);
        transition: all 0.25s ease;
        border: none;
        cursor: pointer;
    }

    .btn-hero-primary:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 14px 35px rgba(245, 158, 11, 0.5);
    }

    .btn-hero-secondary {
        background: rgba(255, 255, 255, 0.07);
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        padding: 16px 28px;
        border-radius: var(--radius-md);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--border-glass);
        transition: all 0.25s ease;
    }

    .btn-hero-secondary:hover {
        background: rgba(255, 255, 255, 0.14);
        transform: translateY(-2px);
    }

    .hero-metrics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding-top: 25px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .metric-item h4 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        color: #fff;
    }

    .metric-item p {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Hero Banner Image Card */
    .hero-visual-card {
        position: relative;
        border-radius: var(--radius-lg);
        overflow: hidden;
        border: 2px solid var(--border-glass-gold);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
        transform: perspective(1000px) rotateY(-3deg) rotateX(2deg);
        transition: transform 0.5s ease;
    }

    .hero-visual-card:hover {
        transform: perspective(1000px) rotateY(0deg) rotateX(0deg) scale(1.02);
    }

    .hero-visual-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .hero-visual-badge {
        position: absolute;
        bottom: 20px;
        left: 20px;
        right: 20px;
        background: rgba(12, 21, 36, 0.88);
        backdrop-filter: blur(12px);
        padding: 14px 20px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-glass);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .hero-visual-badge strong {
        display: block;
        font-size: 1rem;
        color: #fff;
    }

    .hero-visual-badge span {
        font-size: 0.8rem;
        color: var(--gold-light);
    }

    /* Champions Showcase Section */
    .section-padding {
        padding: 70px 0;
    }

    .section-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .section-eyebrow {
        color: var(--gold-primary);
        font-family: 'Outfit', sans-serif;
        font-size: 0.88rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 8px;
        display: block;
    }

    .section-title {
        font-family: 'Outfit', sans-serif;
        font-size: 2.5rem;
        font-weight: 900;
        color: #fff;
        margin-bottom: 12px;
    }

    .section-desc {
        color: var(--text-secondary);
        font-size: 1.05rem;
        max-width: 650px;
        margin: 0 auto;
    }

    .champions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 25px;
    }

    .champion-card {
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-glass);
        border-radius: var(--radius-lg);
        padding: 24px;
        backdrop-filter: blur(14px);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .champion-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--card-color, var(--gold-primary));
        opacity: 0.8;
    }

    .champion-card:hover {
        transform: translateY(-8px);
        border-color: rgba(255, 255, 255, 0.25);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    }

    .champion-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .silk-avatar {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.4);
    }

    .champion-odds-pill {
        background: rgba(245, 158, 11, 0.15);
        color: var(--gold-primary);
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.1rem;
        padding: 4px 12px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-glass-gold);
    }

    .champion-name {
        font-family: 'Outfit', sans-serif;
        font-size: 1.35rem;
        font-weight: 800;
        margin-bottom: 4px;
        color: #fff;
    }

    .champion-jockey {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-bottom: 16px;
        display: block;
    }

    .stat-bars {
        margin-bottom: 20px;
    }

    .stat-row {
        margin-bottom: 8px;
    }

    .stat-label-group {
        display: flex;
        justify-content: space-between;
        font-size: 0.78rem;
        margin-bottom: 4px;
        color: var(--text-secondary);
        font-weight: 600;
    }

    .stat-track {
        height: 6px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-full);
        overflow: hidden;
    }

    .stat-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--card-color, var(--gold-primary)), #fff);
        border-radius: var(--radius-full);
    }

    .champion-quote {
        font-size: 0.85rem;
        color: #cbd5e1;
        font-style: italic;
        margin-bottom: 18px;
        min-height: 40px;
    }

    .btn-select-runner {
        width: 100%;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--border-glass);
        color: #fff;
        padding: 10px;
        border-radius: var(--radius-md);
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-select-runner:hover {
        background: var(--gold-primary);
        color: #000;
        border-color: var(--gold-primary);
    }

    /* Interactive Racing Arena */
    .arena-section {
        background: radial-gradient(circle at 50% 20%, #122238 0%, #080f1c 70%, #040810 100%);
        border-top: 1px solid var(--border-glass);
        border-bottom: 1px solid var(--border-glass);
        padding: 60px 0 80px;
        position: relative;
    }

    .arena-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Announcer Commentary Ticker */
    .announcer-bar {
        background: rgba(15, 23, 42, 0.88);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-glass-gold);
        border-radius: var(--radius-md);
        padding: 12px 20px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    }

    .announcer-tag {
        background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
        color: #000;
        font-family: 'Outfit', sans-serif;
        font-weight: 900;
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 6px;
        letter-spacing: 1px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .announcer-text {
        font-size: 0.96rem;
        color: #f1f5f9;
        font-weight: 500;
        flex-grow: 1;
        transition: all 0.3s;
    }

    .announcer-text.highlight {
        color: var(--gold-light);
        font-weight: 700;
    }

    /* The Race Track */
    .track-wrapper {
        position: relative;
        background: #112015;
        border: 6px solid #63381e;
        border-radius: 20px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), inset 0 0 40px rgba(0, 0, 0, 0.6);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .track-weather-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 10;
        transition: opacity 0.5s ease;
    }

    .weather-sunset {
        background: linear-gradient(180deg, rgba(249, 115, 22, 0.22) 0%, rgba(217, 70, 239, 0.18) 100%);
    }

    .weather-night {
        background: rgba(5, 10, 25, 0.5);
        box-shadow: inset 0 0 100px rgba(0,0,0,0.85);
    }

    .weather-rain {
        background: linear-gradient(180deg, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%);
    }

    .track-header {
        background: linear-gradient(90deg, #1b3a27, #245837, #1b3a27);
        padding: 10px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #3c7a50;
        color: #a7f3d0;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 1.5px;
    }

    .furlong-markers {
        display: flex;
        justify-content: space-between;
        padding: 5px 65px 5px 95px;
        background: rgba(0,0,0,0.35);
        font-size: 11px;
        color: #6ee7b7;
        font-weight: 700;
        letter-spacing: 1px;
        border-bottom: 1px dashed rgba(255,255,255,0.15);
    }

    .race-track {
        position: relative;
        background: repeating-linear-gradient(
            0deg,
            var(--turf-green) 0px,
            var(--turf-green) 42px,
            var(--turf-stripe) 42px,
            var(--turf-stripe) 84px
        );
    }

    .start-gate-area {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 80px;
        background: rgba(30, 41, 59, 0.85);
        border-right: 3px solid #e2e8f0;
        z-index: 5;
        display: flex;
        flex-direction: column;
    }

    .gate-stall {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        font-weight: 900;
        font-family: 'Outfit', sans-serif;
        color: #94a3b8;
        font-size: 13px;
        background: linear-gradient(90deg, rgba(0,0,0,0.5), transparent);
    }

    .finish-line-post {
        position: absolute;
        right: 80px;
        top: 0;
        bottom: 0;
        width: 14px;
        background: repeating-linear-gradient(
            0deg,
            #ffffff 0px,
            #ffffff 10px,
            #000000 10px,
            #000000 20px
        );
        box-shadow: 0 0 15px rgba(255,255,255,0.7);
        z-index: 6;
    }

    .finish-banner {
        position: absolute;
        right: 50px;
        top: 0px;
        background: var(--crimson-accent);
        color: white;
        font-weight: 900;
        font-family: 'Outfit', sans-serif;
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 0 0 8px 8px;
        letter-spacing: 1px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        z-index: 7;
    }

    .lane {
        height: 85px;
        position: relative;
        border-bottom: 2px dashed rgba(255, 255, 255, 0.25);
        display: flex;
        align-items: center;
    }

    .lane:last-child {
        border-bottom: none;
    }

    .horse-container {
        position: absolute;
        left: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
        z-index: 8;
        transition: left 0.05s linear;
        cursor: pointer;
    }

    .horse-sprite {
        width: 60px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transform-origin: bottom center;
        filter: drop-shadow(0 6px 6px rgba(0, 0, 0, 0.5));
    }

    .galloping .horse-sprite {
        animation: gallopCycle 0.35s infinite ease-in-out alternate;
    }

    @keyframes gallopCycle {
        0% { transform: translateY(0px) rotate(0deg) scaleX(1); }
        50% { transform: translateY(-8px) rotate(-4deg) scaleX(1.05); }
        100% { transform: translateY(2px) rotate(4deg) scaleX(0.95); }
    }

    .horse-emoji {
        font-size: 42px;
        display: inline-block;
        transform: scaleX(-1);
    }

    .jockey-badge {
        position: absolute;
        top: 2px;
        left: 12px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
        box-shadow: 0 2px 5px rgba(0,0,0,0.5);
    }

    .horse-info-tag {
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.2);
        padding: 3px 8px;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        white-space: nowrap;
        pointer-events: none;
    }

    .horse-info-tag .name {
